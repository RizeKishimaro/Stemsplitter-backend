HOST=127.0.0.1
PORT=8787
DATABASE_URL=postgres://soniclab:soniclab@localhost:5432/soniclab
DATABASE_MAX_CONNECTIONS=10
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=1073741824
JOB_CONCURRENCY=1
JOB_POLL_INTERVAL_MS=500
AUDIO_JOB_TTL_SECS=86400
# Optional override. If unset, startup searches existing environments before installing.
# DEMUCS_PYTHON=/path/to/demucs/bin/python
DEMUCS_RUNTIME_DIR=./data/runtime/demucs
DEMUCS_WORKER_SCRIPT=worker/demucs_worker.py
DEMUCS_DEVICE=auto
DEMUCS_ALLOW_CPU_FALLBACK=false
DEMUCS_STARTUP_TIMEOUT_SECS=600
DEMUCS_CANCEL_TIMEOUT_SECS=60
BEAT_THIS_MEL_MODEL=models/mel_spectrogram.onnx
BEAT_THIS_MODEL=models/beat_this.onnx
BEAT_THIS_THREADS=16
# Optional descriptive model/checkpoint identifier; left unset unless known.
# BEAT_THIS_MODEL_VERSION=
RUST_LOG=soniclab_backend=info,tower_http=info
CORS_ALLOW_ORIGINS=http://localhost:5173
